# Variables de entorno del proyecto de Vercel (Settings > Environment Variables)

# Cadena de conexión de Supabase (Project Settings > Database > Connection string > Transaction pooler, puerto 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Cadena larga y aleatoria, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Opcional (por defecto America/Bogota)
APP_TIMEZONE=America/Bogota

# Jefe inicial: se crea solo al arrancar si todavía no existe ningún Jefe
INITIAL_CHIEF_DOCUMENT=
INITIAL_CHIEF_PIN=
INITIAL_CHIEF_FIRST_NAME=
INITIAL_CHIEF_LAST_NAME=
INITIAL_CHIEF_BIRTH_DATE=

# Opcional: Google Maps (autocompletar lugares y mostrar el mapa). Sin ella, se escribe el lugar a mano
# y aparece un enlace "Abrir en Google Maps". Requiere habilitar Maps JavaScript API, Places API (New),
# Maps Embed API y Geocoding API, y conviene restringirla por sitio web (cavsur.vercel.app/*).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Opcional: Map ID propio (Google Cloud > Map Management). Por defecto se usa DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
