# Variables de entorno del proyecto de Vercel (Settings > Environment Variables)

# Cadena de conexión de Supabase (Project Settings > Database > Connection string > Transaction pooler, puerto 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Cadena larga y aleatoria, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Opcional (por defecto America/Bogota)
APP_TIMEZONE=America/Bogota
